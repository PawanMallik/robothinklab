# ==============================================================
# RoboThinkLab - Email & SMTP Configuration
# ==============================================================
# For Netlify:
# Go to Site configuration -> Environment variables -> Add a variable
#
# For Gmail:
# 1. Turn on 2-Step Verification in Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "RoboThinkLab")
# 4. Copy the 16-character App Password generated by Google
# ==============================================================

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
RECEIVER_EMAIL=your-destination-email@gmail.com
EMAIL_SERVICE=gmail
